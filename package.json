{
  "name": "analyticsdev-mcp-servers",
  "version": "0.1.0",
  "description": "MCP servers for Meta, Google Ads, Microsoft Advertising (Bing), OpenAI Ads, GA4, Matomo, Looker Studio, BigQuery, Stape (sGTM), Google Tag Manager, n8n, ClickUp, Slack and Zoho CRM",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "mcp-meta": "dist/meta/index.js",
    "mcp-google-ads": "dist/google-ads/index.js",
    "mcp-microsoft-ads": "dist/microsoft-ads/index.js",
    "mcp-openai-ads": "dist/openai-ads/index.js",
    "mcp-ga4": "dist/ga4/index.js",
    "mcp-looker-studio": "dist/looker-studio/index.js",
    "mcp-bigquery": "dist/bigquery/index.js",
    "mcp-stape": "dist/stape/index.js",
    "mcp-gtm": "dist/gtm/index.js",
    "mcp-n8n": "dist/n8n/index.js",
    "mcp-clickup": "dist/clickup/index.js",
    "mcp-slack": "dist/slack/index.js",
    "mcp-matomo": "dist/matomo/index.js",
    "mcp-zoho-crm": "dist/zoho-crm/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "auth:ga4": "node dist/shared/google-signin.js ga4",
    "auth:looker-studio": "node dist/shared/google-signin.js looker-studio",
    "auth:gtm": "node dist/shared/google-signin.js gtm",
    "auth:bigquery": "node dist/shared/google-signin.js bigquery",
    "auth:google-ads": "node dist/shared/google-signin.js google-ads",
    "auth:microsoft-ads": "node dist/microsoft-ads/signin.js",
    "auth:microsoft-ads-google": "node dist/shared/google-signin.js microsoft-ads",
    "auth:zoho-crm": "node dist/zoho-crm/signin.js",
    "dev:meta": "tsx src/meta/index.ts",
    "dev:google-ads": "tsx src/google-ads/index.ts",
    "dev:microsoft-ads": "tsx src/microsoft-ads/index.ts",
    "dev:openai-ads": "tsx src/openai-ads/index.ts",
    "dev:ga4": "tsx src/ga4/index.ts",
    "dev:looker-studio": "tsx src/looker-studio/index.ts",
    "dev:bigquery": "tsx src/bigquery/index.ts",
    "dev:stape": "tsx src/stape/index.ts",
    "dev:gtm": "tsx src/gtm/index.ts",
    "dev:n8n": "tsx src/n8n/index.ts",
    "dev:clickup": "tsx src/clickup/index.ts",
    "dev:slack": "tsx src/slack/index.ts",
    "dev:matomo": "tsx src/matomo/index.ts",
    "dev:zoho-crm": "tsx src/zoho-crm/index.ts",
    "inspect:meta": "npx @modelcontextprotocol/inspector node dist/meta/index.js",
    "inspect:google-ads": "npx @modelcontextprotocol/inspector node dist/google-ads/index.js",
    "inspect:microsoft-ads": "npx @modelcontextprotocol/inspector node dist/microsoft-ads/index.js",
    "inspect:openai-ads": "npx @modelcontextprotocol/inspector node dist/openai-ads/index.js",
    "inspect:ga4": "npx @modelcontextprotocol/inspector node dist/ga4/index.js",
    "inspect:looker-studio": "npx @modelcontextprotocol/inspector node dist/looker-studio/index.js",
    "inspect:bigquery": "npx @modelcontextprotocol/inspector node dist/bigquery/index.js",
    "inspect:stape": "npx @modelcontextprotocol/inspector node dist/stape/index.js",
    "inspect:gtm": "npx @modelcontextprotocol/inspector node dist/gtm/index.js",
    "inspect:n8n": "npx @modelcontextprotocol/inspector node dist/n8n/index.js",
    "inspect:clickup": "npx @modelcontextprotocol/inspector node dist/clickup/index.js",
    "inspect:slack": "npx @modelcontextprotocol/inspector node dist/slack/index.js",
    "inspect:matomo": "npx @modelcontextprotocol/inspector node dist/matomo/index.js",
    "inspect:zoho-crm": "npx @modelcontextprotocol/inspector node dist/zoho-crm/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "google-auth-library": "^9.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
