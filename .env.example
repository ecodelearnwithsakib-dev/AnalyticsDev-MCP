# ---------- Meta Conversions API (src/meta) ----------
# Events Manager → Settings → Conversions API → Generate access token
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_API_VERSION=v23.0

# ---------- Stape / server-side GTM (src/stape) ----------
# Your sGTM tagging server URL, e.g. https://sgtm.example.com
SGTM_URL=
# Optional: GA4 Measurement Protocol credentials for sgtm_send_ga4_event
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Stape account → Settings → API key (https://api.app.stape.io/api/doc)
STAPE_API_KEY=
# Set to EU if your Stape account is on the EU environment
STAPE_REGION=

# ---------- Google Tag Manager API (src/gtm) ----------
# Path to a service-account JSON that has been added as a user in GTM
GOOGLE_APPLICATION_CREDENTIALS=
