# ---------- Global switches (every server) ----------
# Agency mode: MCP_PROFILE=acme also loads .env.acme (overrides this file); usually set per app entry instead
MCP_PROFILE=
# true = hide write tools and refuse write actions (see docs/SECURITY-AND-AGENCY.md)
MCP_READ_ONLY=
# Comma-separated tool-name globs, e.g. ga4_run_*,meta_get_*
MCP_ALLOW_TOOLS=
MCP_DENY_TOOLS=
# MCP_HOME (set in your shell or the app entry, not here) moves this file and .state/ elsewhere; npx uses ~/.analyticsdev-mcp
# Any value below may be keychain:NAME (macOS Keychain) or op://vault/item/field (1Password) — see `npm run secret`

# ---------- Meta: Ads, Pages, Instagram, CAPI, Catalog (src/meta) ----------
# Best: a System User token from Business Settings → Users → System users,
# with ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, pages_manage_posts, pages_manage_engagement,
# pages_manage_metadata, read_insights, leads_retrieval, instagram_basic,
# instagram_content_publish, instagram_manage_insights, catalog_management.
META_ACCESS_TOKEN=
# Optional: your app secret; adds appsecret_proof to every call
META_APP_SECRET=
# Defaults used when a tool call does not pass an ID
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_BUSINESS_ID=
META_API_VERSION=v25.0

# ---------- Google OAuth client shared by every Google server (auth:* asks for it if empty) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Google Analytics 4 (src/ga4) ----------
# Option A (recommended): OAuth as yourself. Create a "Desktop app" OAuth client in
# Google Cloud (enable Analytics Admin API + Analytics Data API), fill the two values
# below, then run `npm run auth:ga4` — it signs you in and fills the refresh token.
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
# Option B: leave the OAuth values empty and use a service account via
# GOOGLE_APPLICATION_CREDENTIALS (add its email as a user in GA4).
# Defaults used when a tool call does not pass an ID
GA4_ACCOUNT_ID=
GA4_PROPERTY_ID=
# GA4_MEASUREMENT_ID / GA4_API_SECRET below are shared with ga4_mp_send_event

# ---------- Looker Studio (src/looker-studio) ----------
# Report-link tools (Linking API) need nothing here and work for any Google account.
# Search/sharing tools need the Looker Studio API, which is only available to
# Google Workspace / Cloud Identity users after an admin authorizes the OAuth
# client ID in Admin console → Security → API controls → Domain-wide delegation
# with scope https://www.googleapis.com/auth/datastudio.
# Reuses GA4_OAUTH_CLIENT_ID/SECRET unless these are set:
LOOKER_STUDIO_OAUTH_CLIENT_ID=
LOOKER_STUDIO_OAUTH_CLIENT_SECRET=
# Filled by `npm run auth:looker-studio`
LOOKER_STUDIO_OAUTH_REFRESH_TOKEN=
# Alternative: service account (GOOGLE_APPLICATION_CREDENTIALS) impersonating this user
LOOKER_STUDIO_IMPERSONATE_USER=

# ---------- Stape / server-side GTM (src/stape) ----------
# Your sGTM tagging server URL, e.g. https://sgtm.example.com
SGTM_URL=
# Optional: X-Gtm-Server-Preview value (GTM server container → Preview → ⋮ →
# Send requests manually) so test hits appear in sGTM Preview
SGTM_PREVIEW_HEADER=
# GA4 Measurement Protocol credentials (ga4_mp_send_event, sgtm_send_ga4_event)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Stape account → Settings → API key. Unlocks all official Stape tools (stape_*)
STAPE_API_KEY=
# Set to EU if your Stape account is on the EU environment
STAPE_REGION=

# ---------- Google Tag Manager (src/gtm) ----------
# Reuses GA4_OAUTH_CLIENT_ID/SECRET (enable "Tag Manager API" in the same Google
# Cloud project), then `npm run auth:gtm` fills the refresh token.
GTM_OAUTH_CLIENT_ID=
GTM_OAUTH_CLIENT_SECRET=
GTM_OAUTH_REFRESH_TOKEN=
# Defaults used when a tool call does not pass IDs (container may be GTM-XXXXXXX)
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
# Optional; defaults to the container's "Default Workspace"
GTM_WORKSPACE_ID=

# ---------- BigQuery (src/bigquery) ----------
# Reuses GA4_OAUTH_CLIENT_ID/SECRET (enable "BigQuery API" and, for scheduled
# queries, "BigQuery Data Transfer API"), then `npm run auth:bigquery`.
BIGQUERY_OAUTH_CLIENT_ID=
BIGQUERY_OAUTH_CLIENT_SECRET=
BIGQUERY_OAUTH_REFRESH_TOKEN=
# Default (billing) project and job location, e.g. US, EU, asia-south1
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=US
# Safety cap per query in bytes (default 10 GiB ≈ USD 0.06 on-demand)
BIGQUERY_MAX_BYTES_BILLED=10737418240

# ---------- Google Ads (src/google-ads) ----------
# Developer token: Google Ads manager account → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
# Reuses GA4_OAUTH_CLIENT_ID/SECRET (enable "Google Ads API"), then `npm run auth:google-ads`
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
# Default account to work on, and your manager (MCC) ID if you access it through one
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# ---------- Microsoft Advertising / Bing Ads (src/microsoft-ads) ----------
# Developer token: ads.microsoft.com → Settings → Developer settings (Super Admin → Request token)
MSADS_DEVELOPER_TOKEN=
# Account ID (the "aid" in the Ads URL, not the account number); customer ID is looked up if empty
MSADS_ACCOUNT_ID=
MSADS_CUSTOMER_ID=
# Sign-in option A — you log in to Microsoft Ads with Google: reuses GA4_OAUTH_CLIENT_ID/SECRET,
# then `npm run auth:microsoft-ads-google` fills MSADS_GOOGLE_REFRESH_TOKEN
MSADS_GOOGLE_REFRESH_TOKEN=
# Sign-in option B — Microsoft account: an Entra app registration (redirect URI
# http://localhost:53683/callback, "Mobile and desktop"), then `npm run auth:microsoft-ads`
MSADS_CLIENT_ID=
MSADS_CLIENT_SECRET=
MSADS_REFRESH_TOKEN=
# Set to sandbox to use the Bing Ads sandbox (universal developer token BBD37VB98)
MSADS_ENVIRONMENT=

# ---------- OpenAI Ads / ads in ChatGPT (src/openai-ads) ----------
# Advertiser API key: ads.openai.com → Settings → API keys (one key per ad account)
OPENAI_ADS_API_KEY=
# Conversions API: Pixel ID and CAPI key from the Conversions tab (or create with oai_ads_conversion_setup)
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CONVERSIONS_API_KEY=
# Only for API partners using a partner key: the client ad account to act on
OPENAI_ADS_AD_ACCOUNT_ID=

# ---------- n8n (src/n8n) ----------
# Instance URL, e.g. https://yourname.app.n8n.cloud or http://localhost:5678
N8N_URL=
# Public REST API key: n8n → Settings → n8n API → Create an API key (not on the free trial)
N8N_API_KEY=
# Optional: native MCP token (Settings → Instance-level MCP → Connect → API key tab) to add
# n8n's own build/validate/test/run tools through the same server
N8N_MCP_TOKEN=

# ---------- ClickUp (src/clickup) ----------
# Personal API token: ClickUp → avatar → Settings → Apps → API Token (starts with pk_)
CLICKUP_API_TOKEN=
# Workspace ID (the number after app.clickup.com/ in the URL); optional if you have only one workspace
CLICKUP_TEAM_ID=

# ---------- Slack (src/slack) ----------
# Create the app from slack-app-manifest.json (api.slack.com/apps → Create New App → From a manifest),
# Install to Workspace, then copy OAuth & Permissions → User OAuth Token (xoxp-…)
SLACK_USER_TOKEN=
# Optional: Bot User OAuth Token (xoxb-…) for posting as the app (as_bot: true)
SLACK_BOT_TOKEN=
# The official Slack MCP tools are proxied with the user token once "Model Context Protocol" is
# turned on under Agents & AI Apps in the app; set to off to skip them
SLACK_OFFICIAL_MCP=

# ---------- Matomo (src/matomo) ----------
# Instance URL, e.g. https://analytics.example.com or https://yourname.matomo.cloud
MATOMO_URL=
# Personal security token: Matomo → Administration → Personal → Security → Auth tokens → Create new token
MATOMO_TOKEN=
# Default site (idSite) for reports
MATOMO_SITE_ID=
# The official "MCP Server" plugin (Matomo 5.8+) is proxied automatically when installed; set to off to skip
MATOMO_OFFICIAL_MCP=

# ---------- Zoho CRM (src/zoho-crm) ----------
# api-console.zoho.com (use your data center's console, e.g. api-console.zoho.in) → Add Client →
# Server-based Applications, Homepage http://localhost, Redirect URI http://localhost:53684/callback.
# Put the Client ID/Secret here, then `npm run auth:zoho-crm` signs you in and fills the rest.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data center of your Zoho account: com (US), eu, in, com.au, jp, ca, sa, com.cn
ZOHO_DC=com
# Filled by `npm run auth:zoho-crm`
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=
ZOHO_ACCOUNTS_URL=

# ---------- Odoo (src/odoo) ----------
# Your Odoo address, e.g. https://yourcompany.odoo.com or https://erp.example.com
ODOO_URL=
# API key: avatar → My Preferences (Preferences) → Account Security → New API Key
# (Odoo 19+ keys last at most 3 months — rotate before they expire)
ODOO_API_KEY=
# Database name — only needed if the server hosts several databases (Odoo Online: auto-detected)
ODOO_DB=
# Odoo 18 and older only (JSON-RPC): the login (email) of the key's user
ODOO_LOGIN=
# Optional: json2 or jsonrpc to skip auto-detection; en_US etc. for field labels
ODOO_PROTOCOL=
ODOO_LANG=

# ---------- HighLevel / GoHighLevel (src/ghl) ----------
# Sub-account → Settings → Private Integrations → Create new integration, tick the scopes you need
# (contacts, conversations, opportunities, calendars, workflows, users, locations, invoices, payments…),
# then copy the token (starts with pit-)
GHL_API_TOKEN=
# Sub-account (location) ID: Settings → Business Profile, or the id in app.gohighlevel.com/v2/location/<ID>/
GHL_LOCATION_ID=

# ---------- Pipedrive (src/pipedrive) ----------
# Your company domain: the "acme" in acme.pipedrive.com
PIPEDRIVE_DOMAIN=
# Personal API token: avatar → Personal preferences → API (acts as you, with your permissions)
PIPEDRIVE_API_TOKEN=

# ---------- Salesforce (src/salesforce) ----------
# Setup → External Client App Manager → New External Client App: enable OAuth, callback
# http://localhost:53685/callback, scopes "Manage user data via APIs (api)" and "Perform requests at any
# time (refresh_token, offline_access)", require PKCE. Copy the Consumer Key/Secret here.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Your My Domain login URL, e.g. https://acme.my.salesforce.com (sandbox: https://acme--dev.sandbox.my.salesforce.com)
SF_LOGIN_URL=
# Filled by `npm run auth:salesforce` (leave empty to use the client-credentials flow with a Run As user)
SF_REFRESH_TOKEN=
SF_INSTANCE_URL=
# Optional: REST API version (default v65.0)
SF_API_VERSION=

# ---------- Reddit: Ads API + community (src/reddit) ----------
# reddit.com/prefs/apps → create app → type "web app", redirect uri http://localhost:53686/callback.
# Copy the id under the app name and the secret, then `npm run auth:reddit` fills REDDIT_REFRESH_TOKEN
# (one sign-in grants both the Data API and the Ads API scopes).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# Reddit asks for a descriptive User-Agent, e.g. node:ecode-mcp:1.0 (by /u/yourname)
REDDIT_USER_AGENT=
# Ads defaults: ad account (t2_… / a2_…) and pixel id from Ads Manager
REDDIT_AD_ACCOUNT_ID=
REDDIT_PIXEL_ID=
REDDIT_BUSINESS_ID=
# Optional: a Conversions API access token from Events Manager (else the OAuth token is used)
REDDIT_CONVERSION_TOKEN=

# ---------- Google Search Console (src/search-console) ----------
# Uses the Google OAuth client from GA4 (GOOGLE_OAUTH_* or GA4_OAUTH_*). Enable "Google Search Console API",
# then `npm run auth:search-console` fills SEARCH_CONSOLE_OAUTH_REFRESH_TOKEN.
SEARCH_CONSOLE_OAUTH_REFRESH_TOKEN=
# Default property: https://www.example.com/ or sc-domain:example.com
SEARCH_CONSOLE_SITE=

# ---------- Google Merchant Center (src/merchant-center) ----------
# Enable "Merchant API", then `npm run auth:merchant` fills MERCHANT_OAUTH_REFRESH_TOKEN.
MERCHANT_OAUTH_REFRESH_TOKEN=
MERCHANT_ACCOUNT_ID=
# Optional defaults for product updates: data source ID (accounts/…/dataSources/ID), feed label, currency
MERCHANT_DATA_SOURCE=
MERCHANT_FEED_LABEL=
MERCHANT_CURRENCY=

# ---------- YouTube Analytics (src/youtube-analytics) ----------
# Enable "YouTube Analytics API" and "YouTube Data API v3", then `npm run auth:youtube`.
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Optional: channel ID (UC…); default is the signed-in user's channel
YOUTUBE_CHANNEL_ID=

# ---------- Google Sheets (src/google-sheets) ----------
# Enable "Google Sheets API" and "Google Drive API", then `npm run auth:sheets`.
# Also used by monitor_report to append rows to a sheet.
SHEETS_OAUTH_REFRESH_TOKEN=

# ---------- LinkedIn Ads (src/linkedin-ads) ----------
# linkedin.com/developers → create app → Products: Advertising API (+ Conversions API).
# Auth tab: add redirect URL http://localhost:53687/callback, then `npm run auth:linkedin`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# Or a 60-day access token instead of the refresh flow
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
# API version YYYYMM (optional)
LINKEDIN_VERSION=

# ---------- Pinterest Ads (src/pinterest-ads) ----------
# developers.pinterest.com → My apps → redirect URI http://localhost:53687/callback, then `npm run auth:pinterest`.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=

# ---------- Snapchat Ads (src/snapchat-ads) ----------
# Ads Manager → Business Details → OAuth App, redirect URI http://localhost:53687/callback, then `npm run auth:snapchat`.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
SNAPCHAT_AD_ACCOUNT_ID=
# Conversions API: pixel ID and a CAPI token from Events Manager
SNAPCHAT_PIXEL_ID=
SNAPCHAT_CAPI_TOKEN=

# ---------- X (Twitter) Ads (src/x-ads) ----------
# developer.x.com app with Ads API access → Keys and tokens (OAuth 1.0a, user with ad account access).
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_ADS_ACCOUNT_ID=
X_ADS_CURRENCY=

# ---------- Amazon Ads (src/amazon-ads) ----------
# Login with Amazon security profile approved for the Advertising API; allowed return URL
# http://localhost:53687/callback, then `npm run auth:amazon-ads`. Region: NA, EU or FE.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_REGION=NA
# Profile (marketplace/account) ID — list with amazon_profiles
AMAZON_ADS_PROFILE_ID=

# ---------- TikTok Business API (src/tiktok-business) ----------
# TikTok for Business developer app → long-lived access token (or an Events Manager token for events only).
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_CODE=
TIKTOK_CURRENCY=

# ---------- Shopify (src/shopify) ----------
# Shopify admin → Settings → Apps → Develop apps (or Dev Dashboard) → Admin API scopes:
# read_orders (read_all_orders for >60 days), read_products, write_products, read_customers,
# read_inventory, write_inventory, write_discounts → install → Admin API access token (shpat_…).
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

# ---------- WooCommerce (src/woocommerce) ----------
# WP admin → WooCommerce → Settings → Advanced → REST API → Add key (Read/Write). HTTPS required.
WOO_URL=https://shop.example.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ---------- HubSpot CRM (src/hubspot) ----------
# HubSpot → Settings → Integrations → Private apps (or Legacy apps) → scopes: crm.objects.*.read/write,
# crm.schemas.*.read, forms, account-info.security.read → access token (pat-…).
HUBSPOT_ACCESS_TOKEN=
# Currency for deals without deal_currency_code
HUBSPOT_CURRENCY=

# ---------- PostHog (src/posthog) ----------
# Settings → Personal API keys → scopes: query:read, project:read, person:read, feature_flag:read/write, insight:read
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=

# ---------- Mixpanel (src/mixpanel) ----------
# Organization settings → Service accounts → add with access to the project. Region: us, eu or in.
MIXPANEL_SERVICE_ACCOUNT=
MIXPANEL_SERVICE_SECRET=
MIXPANEL_PROJECT_ID=
MIXPANEL_REGION=us

# ---------- Amplitude (src/amplitude) ----------
# Project settings → General → API key and Secret key. Region: us or eu.
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_REGION=us

# ---------- Microsoft Clarity (src/clarity) ----------
# Clarity project → Settings → Data Export → Generate new API token (10 requests/day, last 1–3 days).
CLARITY_API_TOKEN=

# ---------- Klaviyo (src/klaviyo) ----------
# Settings → API keys → Create private API key (read access to everything you need; write for profiles/events).
KLAVIYO_API_KEY=
# Optional: conversion metric for revenue (default: the "Placed Order" metric), report time zone
KLAVIYO_CONVERSION_METRIC_ID=
KLAVIYO_TIMEZONE=

# ---------- Mailchimp (src/mailchimp) ----------
# Profile → Extras → API keys → Create a key (ends with -usXX, the data center).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# ---------- WhatsApp Business Cloud API (src/whatsapp) ----------
# business.facebook.com → System users → generate a permanent token with whatsapp_business_messaging
# and whatsapp_business_management; IDs from developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- Airtable (src/airtable) ----------
# airtable.com/create/tokens → scopes data.records:read/write, schema.bases:read/write → add bases.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# ---------- Notion (src/notion) ----------
# notion.so/profile/integrations → New internal integration → copy the secret; share pages with it (••• → Connections).
NOTION_TOKEN=

# ---------- Cross-platform servers (ads-hub, tracking-audit, conversion-sync, monitor) ----------
# Report currency for blended numbers, e.g. BDT; pin exchange rates with FX_RATES="USD:BDT=121,EUR:BDT=131"
ADS_HUB_CURRENCY=
FX_RATES=
# conversion-sync: where to send won deals
CONVSYNC_GOOGLE_ACTION_ID=
CONVSYNC_MSADS_GOAL=
CONVSYNC_META_EVENT=Purchase
CONVSYNC_LINKEDIN_RULE=
# Currency for CRMs that don't store one, and custom click-ID fields to read
CONVSYNC_CURRENCY=
CONVSYNC_SF_FIELDS=
CONVSYNC_ZOHO_FIELDS=
CONVSYNC_ODOO_FIELDS=
# Test identifiers used by sync_run in test mode
CONVSYNC_META_TEST_CODE=
CONVSYNC_REDDIT_TEST_ID=

# ---------- HTTP gateway for ChatGPT / claude.ai / Open WebUI (npm run serve) ----------
# Created automatically on first `npm run serve`; the only credential remote apps need. Rotate by deleting.
MCP_GATEWAY_TOKEN=
# Optional defaults: port, bind address (keep 127.0.0.1 and use a tunnel), tool filters (comma lists with *)
MCP_GATEWAY_PORT=8787
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_ALLOW=
MCP_GATEWAY_DENY=
# OAuth for claude.ai / ChatGPT connectors (same as --oauth); set the public tunnel URL if the tunnel doesn't forward the host
MCP_GATEWAY_OAUTH=
MCP_GATEWAY_PUBLIC_URL=

# ---------- Service account (GTM / GA4 / Looker Studio / BigQuery fallback) ----------
# Used when no OAuth refresh token is set. Add the service-account email as a user.
GOOGLE_APPLICATION_CREDENTIALS=
